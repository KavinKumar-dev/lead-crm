# ---------------------------------------------------------------------------
# Environment variables — copy to .env.local and fill in your own values.
# ---------------------------------------------------------------------------

# Pooled connection string used by the application at runtime.
# Vercel + Neon: use the "-pooler" URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct (non-pooled) connection string used by Prisma for schema
# operations (migrate / db push).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Throwaway database used by `npm test`. Must NOT be the same as
# DATABASE_URL — the tests truncate every table.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TEST_DATABASE?sslmode=require"

# Secret used to sign the session cookie. Use a long random value.
SESSION_SECRET="replace-with-a-long-random-string"

# Admin account created by `npm run db:seed`.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-characters"

# Set to "true" to also create the demo client (10245 / ClientPass123!).
SEED_DEMO="false"
